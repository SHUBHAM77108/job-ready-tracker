{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/createNativeSsoCode",
        "function": { "functionId": "createNativeSsoCode", "region": "us-central1" }
      },
      {
        "source": "/api/exchangeNativeSsoCode",
        "function": { "functionId": "exchangeNativeSsoCode", "region": "us-central1" }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
