@@ -0,0 +1,26 @@
+package com.buildskills.jobreadytracker
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class TrackerDownloadsTest {
+    @Test
+    fun classifiesDownloadUrlsByScheme() {
+        assertEquals(DownloadKind.HTTPS, classifyDownloadUrl("https://example.com/a.csv"))
+        assertEquals(DownloadKind.HTTPS, classifyDownloadUrl("  HTTPS://example.com/a.csv"))
+        assertEquals(DownloadKind.BLOB, classifyDownloadUrl("blob:https://build-skills-9320a.web.app/1234"))
+        assertEquals(DownloadKind.DATA, classifyDownloadUrl("data:text/csv;base64,YQ=="))
+        assertEquals(DownloadKind.UNSUPPORTED, classifyDownloadUrl("http://example.com/a.csv"))
+        assertEquals(DownloadKind.UNSUPPORTED, classifyDownloadUrl("file:///sdcard/a.csv"))
+        assertEquals(DownloadKind.UNSUPPORTED, classifyDownloadUrl(null))
+    }
+
+    @Test
+    fun fileNamesCannotEscapeTheDownloadsFolder() {
+        assertEquals("report.csv", safeDownloadFileName("report.csv"))
+        assertEquals("_evil.csv", safeDownloadFileName("../evil.csv"))
+        assertEquals("a_b_c.csv", safeDownloadFileName("a/b\\c.csv"))
+        assertEquals("download", safeDownloadFileName("..."))
+        assertEquals("download", safeDownloadFileName(null))
+    }
+}
diff --git a/app/src/test/java/com/buildskills/jobreadytracker/TrackerUploadsTest.kt b/app/src/test/java/com/buildskills/jobreadytracker/TrackerUploadsTest.kt
--- a/app/src/test/java/com/buildskills/jobreadytracker/TrackerUploadsTest.kt	1970-01-01 00:00:00.000000000 +0000
+++ b/app/src/test/java/com/buildskills/jobreadytracker/TrackerUploadsTest.kt	2026-10-29 18:43:28.958146230 +0000
@@ -0,0 +1,44 @@
+package com.buildskills.jobreadytracker
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class TrackerUploadsTest {
+    @Test
+    fun normalizeSplitsLowercasesAndDropsBlanks() {
+        assertEquals(
+            listOf(".csv", ".xlsx", "image/*"),
+            TrackerUploads.normalize(arrayOf(".CSV, .xlsx", "image/*", " ", ".csv")),
+        )
+        assertEquals(emptyList<String>(), TrackerUploads.normalize(null))
+    }
+
+    @Test
+    fun pickerMimeTypesCoverCsvXlsxImagesAndPdf() {
+        assertArrayEquals(arrayOf("*/*"), TrackerUploads.pickerMimeTypes(emptyList()))
+        assertArrayEquals(arrayOf("image/*", "application/pdf"), TrackerUploads.pickerMimeTypes(listOf("image/*", "application/pdf")))
+        val csv = TrackerUploads.pickerMimeTypes(listOf(".csv")).toList()
+        assertTrue("text/csv" in csv)
+        assertTrue("application/octet-stream" in csv)
+        val xlsx = TrackerUploads.pickerMimeTypes(listOf(".xlsx")).toList()
+        assertTrue("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" in xlsx)
+        assertArrayEquals(arrayOf("*/*"), TrackerUploads.pickerMimeTypes(listOf("*/*", ".csv")))
+    }
+
+    @Test
+    fun pickedFilesAreRecheckedAgainstAccept() {
+        val csvOnly = listOf(".csv")
+        assertTrue(TrackerUploads.matches(csvOnly, "application/octet-stream", "Data.CSV"))
+        assertTrue(TrackerUploads.matches(csvOnly, "text/csv", "export"))
+        assertFalse(TrackerUploads.matches(csvOnly, "application/x-msdownload", "setup.exe"))
